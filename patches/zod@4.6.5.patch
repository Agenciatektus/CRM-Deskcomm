+// Patch do DeskcommCRM (patches/zod@4.6.5.patch): só os idiomas que o produto
+// usa. O índice completo (`./index.js`, ~50 idiomas) ia inteiro para o bundle do
+// navegador, porque o Turbopack não descarta o namespace `z.locales`. Para
+// voltar a ter outro idioma, acrescente a linha dele aqui.
+export { default as en } from "./en.js";
+export { default as pt } from "./pt.js";
+export { default as es } from "./es.js";
